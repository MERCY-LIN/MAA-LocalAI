{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "LocalAI: doctor",
            "type": "process",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/tools/localai-workflow/localai.ps1",
                "doctor"
            ],
            "problemMatcher": []
        },
        {
            "label": "LocalAI: verify",
            "type": "process",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/tools/localai-workflow/localai.ps1",
                "verify"
            ],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "LocalAI: test Python",
            "type": "process",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/tools/localai-workflow/localai.ps1",
                "test-python"
            ],
            "problemMatcher": []
        },
        {
            "label": "LocalAI: test C#",
            "type": "process",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/tools/localai-workflow/localai.ps1",
                "test-dotnet"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "LocalAI: build GUI",
            "type": "process",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/tools/localai-workflow/localai.ps1",
                "build-gui"
            ],
            "group": "build",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "LocalAI: run UI",
            "type": "process",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/tools/localai-workflow/localai.ps1",
                "run-ui"
            ],
            "problemMatcher": []
        }
    ]
}
